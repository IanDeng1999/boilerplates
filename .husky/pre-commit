#!/bin/sh

echo "Running version check..."
pnpm run check-versions

if [ $? -ne 0 ]; then
  echo "Version check failed. Please fix the issues before committing."
  exit 1
fi

# 运行TypeScript编译检查
echo "Running TypeScript type check..."
pnpm exec tsc --noEmit

if [ $? -ne 0 ]; then
  echo "TypeScript type check failed. Please fix the type errors before committing."
  exit 1
fi

# 检查是否有 JS/TS/JSX/TSX/JSON 文件被修改（排除已删除的文件）
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
NEED_LINT=$(echo "$STAGED_FILES" | grep -E '\.(js|ts|jsx|tsx|json)$' || true)

# 运行 Biome 检查（仅当有相关文件时）
if [ -n "$NEED_LINT" ]; then
  echo "Running Biome check on staged files..."
  pnpm exec biome check --staged

  if [ $? -ne 0 ]; then
    echo "Biome check failed. Please fix the issues before committing."
    exit 1
  fi
else
  echo "No JS/TS/JSX/TSX/JSON files changed, skipping Biome check."
fi
