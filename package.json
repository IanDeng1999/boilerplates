{
  "name": "unnamed-fastify-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/start.ts",
    "build": "tsup",
    "start:prod": "node dist/start.js",
    "prepare": "husky",
    "check": "tsc --noEmit && biome check --write",
    "check-versions": "node infra/ci/check-versions.js",
    "cz": "cz",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate:gen": "drizzle-kit generate",
    "db:migrate:run": "drizzle-kit migrate",
    "db:migrate:force-push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/shared/db/seeds/index.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/static": "10.1.0",
    "@sapphire/snowflake": "3.5.5",
    "app-root-path": "3.1.0",
    "drizzle-orm": "0.45.2",
    "drizzle-seed": "0.3.1",
    "es-toolkit": "1.46.1",
    "fast-safe-stringify": "2.1.1",
    "fastify": "5.8.5",
    "fastify-type-provider-zod": "6.1.0",
    "ioredis": "5.10.0",
    "lilconfig": "3.1.3",
    "mitt": "3.0.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "pino-roll": "4.0.0",
    "postgres": "3.4.9",
    "socket.io": "4.8.3",
    "statuses": "2.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.3.1",
    "@types/node": "25.9.1",
    "@types/statuses": "2.0.6",
    "@vitest/coverage-v8": "4.1.7",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "depcheck": "1.4.7",
    "drizzle-kit": "0.31.10",
    "husky": "9.1.7",
    "inquirer": "9.3.8",
    "tsup": "8.5.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "packageManager": "pnpm@11.13.1",
  "volta": {
    "node": "26.5.0"
  }
}
